POSTGRES_DB=zhishu
POSTGRES_USER=zhishu
POSTGRES_PASSWORD=change-this-postgres-password

OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=change-this-opencode-password
OPENCODE_HISTORY_MAX_CHARS=24000
MODEL_BASE_URL=http://127.0.0.1:7136/v1
MODEL_API_KEY=change-this-model-api-key

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_TENANT_NAME=默认租户

# 单个上传 Excel 的字节上限，默认 100 MB
FILE_MAX_SIZE=104857600

# 执行看门狗与步数上限（防止弱模型流式挂死 / 钻牛角尖无限重试）
# AGENT_STALL_TIMEOUT_MS=240000     # 已开工后持续无事件多久判卡死
# AGENT_START_TIMEOUT_MS=150000     # 迟迟不开工多久判失败
# AGENT_OPERATE_STEP_LIMIT=35       # operate 模式工具调用步数上限
# AGENT_REPORT_STEP_LIMIT=90        # report 模式工具调用步数上限

# Web 前端在宿主机上发布的端口，默认 18180（Windows 上 8180 常被 WinNAT 保留段占用）
WEB_PORT=18180
