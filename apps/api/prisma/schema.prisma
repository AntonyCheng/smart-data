// 智数AI助手 — Prisma schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
  binaryTargets = ["windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SysTenant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  users          SysUser[]
  sessions       AiSession[]
  messages       AiMessage[]
  files          AiFile[]
  artifacts      AiArtifact[]
  executions     AiExecution[]
  metricProfiles AiMetricProfile[]

  @@map("sys_tenant")
}

model SysUser {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         String    @default("user")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant   SysTenant   @relation(fields: [tenantId], references: [id])
  sessions AiSession[]

  @@index([tenantId])
  @@map("sys_user")
}

model AiSession {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  title             String    @default("新任务")
  mode              String    @default("operate")
  metricProfileId   String?   @map("metric_profile_id") @db.Uuid
  opencodeSessionId String?   @unique @map("opencode_session_id")
  status            String    @default("ACTIVE")
  categoryPrimary   String?   @map("category_primary")
  categorySecondary String?   @map("category_secondary")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant     SysTenant     @relation(fields: [tenantId], references: [id])
  user       SysUser       @relation(fields: [userId], references: [id])
  messages   AiMessage[]
  files      AiFile[]
  artifacts  AiArtifact[]
  executions AiExecution[]

  @@index([tenantId])
  @@index([userId])
  @@map("ai_session")
}

model AiMessage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String
  content   String
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  SysTenant @relation(fields: [tenantId], references: [id])
  session AiSession @relation(fields: [sessionId], references: [id])
  files   AiFile[]

  @@index([sessionId])
  @@index([tenantId])
  @@map("ai_message")
}

model AiFile {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  sessionId    String?   @map("session_id") @db.Uuid
  messageId    String?   @map("message_id") @db.Uuid
  originalName String    @map("original_name")
  storedName   String    @map("stored_name")
  mimeType     String    @map("mime_type")
  size         BigInt
  path         String
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant  SysTenant  @relation(fields: [tenantId], references: [id])
  session AiSession? @relation(fields: [sessionId], references: [id])
  message AiMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([sessionId])
  @@index([messageId])
  @@map("ai_file")
}

model AiArtifact {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  name         String
  relativePath String   @map("relative_path")
  mediaType    String   @map("media_type")
  size         BigInt
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant  SysTenant @relation(fields: [tenantId], references: [id])
  session AiSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, relativePath])
  @@index([sessionId])
  @@index([tenantId])
  @@map("ai_artifact")
}

/// 企业指标定义集：报告模式下可勾选的、按公司业务口径预写的分析方案。
/// 只作为 prompt 上下文注入，分析逻辑仍全部委托 huashu-excel。
model AiMetricProfile {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  key           String?                                  // 预置集稳定标识；自建集为 null
  name          String
  summary       String    @default("")
  category      String    @default("其他")
  calibers      Json      @default("[]")                 // [{ name, definition }]
  brief         String    @default("") @db.Text          // 关注维度 + 分析要求（markdown）
  reportOutline String?   @map("report_outline") @db.Text
  builtin       Boolean   @default(false)
  enabled       Boolean   @default(true)
  sortOrder     Int       @default(100) @map("sort_order")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant SysTenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("ai_metric_profile")
}

model AiExecution {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  userMessageId String?   @map("user_message_id") @db.Uuid
  status        String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | ABORTED
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  model         String?
  inputTokens   Int?      @map("input_tokens")
  outputTokens  Int?      @map("output_tokens")
  artifactCount Int       @default(0) @map("artifact_count")
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")

  tenant  SysTenant @relation(fields: [tenantId], references: [id])
  session AiSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([tenantId])
  @@map("ai_execution")
}
