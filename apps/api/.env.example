# 本地开发环境（复制为 .env 后填写真实值）。切勿提交 .env 或在生产复用这些默认值。
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/zhishu?schema=public

# OpenCode 运行时（仅内网、Basic Auth）
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=change-me
OPENCODE_HISTORY_MAX_CHARS=24000

# OpenCode 工作目录（含 opencode.json 的 services/excel-agent 根）。
# 会话工作区创建在 {OPENCODE_WORKDIR}/workspaces/{tenantId}/{sessionId}，
# 使 agent 的 read:allow 工具能读到用户上传的 Excel。相对 apps/api 解析。
OPENCODE_WORKDIR=../../services/excel-agent

# 单个上传 Excel 的字节上限，默认 100 MB
FILE_MAX_SIZE=104857600

# --- Auth ---
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# 首次启动、且租户内没有任何管理员时创建的管理员账号。
# SEED_ADMIN_EMAIL 同时作为登录账号，可以是纯用户名（如 admin），不必是邮箱。
# 之后管理员的账号密码由后台自行维护，重启不会覆盖。
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_PASSWORD=replace-with-a-random-development-password
SEED_TENANT_NAME=默认租户
